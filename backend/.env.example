# ─── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your_super_secret_flask_key_change_me
FRONTEND_URL=http://localhost:3000

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=taskhub-images

# ─── Firebase Admin (Backend) ─────────────────────────────────────────────────
# 1. Go to Firebase Console → Project Settings → Service Accounts
# 2. Click "Generate new private key" — download the JSON file
# 3. Place it at: backend/firebase-service-account.json
# 4. Set the path below (or leave default)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ─── Gemini AI ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ─── Pexels API ───────────────────────────────────────────────────────────────
PEXELS_API_KEY=your_pexels_api_key

# ─── Hugging Face (optional, for BiRefNet inference API) ─────────────────────
HF_TOKEN=your_huggingface_token_optional

# ─── SMTP Email (Gmail App Password) ─────────────────────────────────────────
# 1. myaccount.google.com → Security → 2-Step Verification → App passwords
# 2. Create app password for "Mail" → copy the 16-char code (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
